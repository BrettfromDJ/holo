{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-prices",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/sync-catalog",
      "schedule": "43 9 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)ios' ':(exclude).github' ':(exclude)CLAUDE.md'"
}
