{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-prices",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/sync-catalog",
      "schedule": "43 9 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = ci-screenshots ] && exit 0; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)ios' ':(exclude).github' ':(exclude)CLAUDE.md' 2>/dev/null; [ $? -eq 0 ]"
}
