# ---------------------------------------------------------------------------
# Holo environment variables. Copy to .env.local and fill in what you have.
# The app runs in demo mode with none of these set.
# ---------------------------------------------------------------------------

# TCG API (https://tcgapi.dev/dashboard). Server-side only — never exposed to the browser.
TCGAPI_KEY=
# Optional: game slug (default "pokemon") and daily requests kept in reserve for the cron sync.
# TCGAPI_GAME=pokemon
# TCGAPI_DAILY_RESERVE=10

# Supabase (Project Settings → API). The URL and anon key are public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted)
# Service role key: server-only. Used for catalog/price writes and the daily sync.
SUPABASE_SERVICE_ROLE_KEY=
# (SUPABASE_SECRET_KEY is also accepted)

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
